# 凉山伴游后端环境配置模板：复制为 .env 后按需修改（.env 不入库）
# 开箱即跑：全部留空也能启动（SQLite + 规则引擎 + 浏览器语音降级）

APP_NAME=凉山伴游 · 纯伴游导览系统
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8300
DEBUG=1

# 数据库：SQLite 开箱即用；生产可切 MySQL
DATABASE_URL=sqlite:///./banyou.db

# 管理后台 JWT（部署前务必更换）
JWT_SECRET_KEY=please_change_me
JWT_EXPIRE_MINUTES=720

UPLOAD_DIR=./uploads
STATIC_DIR=../frontend
ADMIN_STATIC_DIR=../admin

# AI 伴游 LLM（可选）：配置后应答升级豆包组织语言（知识仍来自本地库）
ARK_API_KEY=
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
ARK_LLM_MODEL=doubao-seed-1-6-flash-250615
ARK_TIMEOUT=20

# 耳机语音沟通（可选）：说话→ASR→应答→TTS 回耳机；与主项目共用凭据
DOUBAO_SPEECH_APP_ID=
DOUBAO_SPEECH_ACCESS_TOKEN=
